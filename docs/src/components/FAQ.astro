---
interface FAQStep {
	title: string;
	description: string;
	href?: string;
	linkLabel?: string;
}

interface FAQ {
	id?: string;
	question: string;
	answer: string;
	steps?: FAQStep[];
}

const faqs: FAQ[] = [
	{
		question: "Is DBcooper free?",
		answer: "Yes — completely free and open source. The full source lives on GitHub under the MIT license.",
	},
	{
		question: "Which databases are supported?",
		answer: "PostgreSQL, MySQL, MariaDB, SQLite, DuckDB, Redis, ClickHouse, and Cloudflare D1 today. More engines are planned for future releases.",
	},
	{
		id: "cloudflare-d1-setup",
		question: "How do I connect to Cloudflare D1?",
		answer: "DBcooper needs a Cloudflare Account ID and a scoped API token. D1 uses Cloudflare's HTTPS API, so SSH tunnels are not used.",
		steps: [
			{
				title: "Copy your Account ID.",
				description: "Open Account home in the Cloudflare dashboard, find the account, open its menu, and choose Copy account ID.",
				href: "https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/",
				linkLabel: "Account ID guide",
			},
			{
				title: "Create a custom API token.",
				description: "Go to My Profile, API Tokens, Create Token, then Create Custom Token. Choose Account, D1, and Read for browsing, or Edit if DBcooper should create tables or change rows. Scope the token to the account you copied.",
				href: "https://developers.cloudflare.com/fundamentals/api/get-started/create-token/",
				linkLabel: "API token guide",
			},
			{
				title: "Copy the token immediately.",
				description: "Cloudflare shows the token secret only once. Store it securely, then paste it and the Account ID into DBcooper and select Load databases.",
			},
		],
	},
	{
		question: "Can DBcooper create a local database for me?",
		answer: "Yes. DBcooper can create a DuckDB file directly. With Docker running, it can also create PostgreSQL 17, MySQL 8.4, MariaDB 11.4, Redis 7, or ClickHouse 25.8 with a persistent volume and a ready-to-use connection. Quitting the app stops containers it created without deleting their data. You can also link compatible containers from the current Docker context, including Docker Compose services.",
	},
	{
		question: "Does it work on Windows or Linux?",
		answer: "DBcooper is macOS-only for now. Windows and Linux builds are being considered.",
	},
	{
		question: "How do I connect via SSH tunnel?",
		answer: "When adding a connection, enable the SSH tunnel option and provide your SSH host, port, username, and authentication method (password or private key).",
	},
	{
		question: "Is my data secure?",
		answer: "DBcooper has no telemetry. Connection credentials stay in its local application store and are sent only to the database service you configure when DBcooper connects.",
	},
	{
		question: "How do I report bugs or request features?",
		answer: "Open an issue on the GitHub repository. All feedback and contributions are welcome.",
	},
];
---

<section id="faq" class="faq-section">
	<div class="faq-layout">
		<div class="faq-heading">
			<h2>Frequently<br />asked.</h2>
			<p>Short answers about support, privacy, and how DBcooper works.</p>
		</div>

		<div class="faq-list">
			{faqs.map((faq, index) => (
				<details id={faq.id} class="faq-item" open={index === 0 || faq.id === "cloudflare-d1-setup"}>
					<summary>
						<span class="faq-index">{String(index + 1).padStart(2, "0")}</span>
						<span class="faq-question">{faq.question}</span>
						<span class="faq-toggle" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
							</svg>
						</span>
					</summary>
					<div class="faq-answer">
						<p>{faq.answer}</p>
						{faq.steps && (
							<ol class="faq-steps">
								{faq.steps.map((step) => (
									<li>
										<strong>{step.title}</strong> {step.description}{" "}
										{step.href && step.linkLabel && (
											<a href={step.href} target="_blank" rel="noreferrer">
												{step.linkLabel} ↗
											</a>
										)}
									</li>
								))}
							</ol>
						)}
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq-section {
		border-bottom: 1px solid var(--line);
		padding-block: clamp(80px, 7.5vw, 108px);
	}

	.faq-layout {
		display: grid;
		grid-template-columns: minmax(240px, 0.58fr) minmax(520px, 1.42fr);
		gap: clamp(52px, 9vw, 138px);
	}

	.faq-heading > p:last-child {
		max-width: 320px;
		margin: 28px 0 4px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.86rem;
		line-height: 1.75;
	}

	.faq-list {
		border-top: 1px solid var(--line-strong);
	}

	.faq-item {
		border-bottom: 1px solid var(--line);
		transition: background 180ms ease;
	}

	.faq-item[open] {
		background: var(--cyan-wash);
	}

	.faq-item:target {
		scroll-margin-top: 6rem;
	}

	.faq-item summary {
		display: grid;
		align-items: center;
		grid-template-columns: 46px 1fr 24px;
		gap: 20px;
		cursor: pointer;
		padding: 24px 18px;
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-index {
		color: var(--cyan);
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	.faq-question {
		font-size: 1.08rem;
		font-weight: 600;
	}

	.faq-toggle {
		display: grid;
		width: 24px;
		height: 24px;
		color: var(--cyan);
		place-items: center;
		transition: transform 220ms ease;
	}

	.faq-toggle svg {
		width: 19px;
		height: 19px;
	}

	.faq-item[open] .faq-toggle {
		transform: rotate(45deg);
	}

	.faq-answer {
		max-width: 720px;
		margin: 0;
		padding: 0 60px 26px 84px;
		color: var(--ink-soft);
		font-size: 0.92rem;
		line-height: 1.7;
	}

	.faq-answer > p {
		margin: 0;
	}

	.faq-steps {
		display: grid;
		gap: 0.75rem;
		margin: 1rem 0 0;
		padding-left: 1.25rem;
	}

	.faq-steps a {
		color: var(--cyan);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.faq-steps a:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.faq-layout {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.faq-layout {
			gap: 46px;
		}

		.faq-item summary {
			grid-template-columns: 32px 1fr 22px;
			gap: 12px;
			padding-inline: 8px;
		}

		.faq-question {
			font-size: 0.98rem;
		}

		.faq-answer {
			padding: 0 34px 24px 52px;
			font-size: 0.84rem;
		}
	}
</style>
